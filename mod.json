{
	"geode": "5.10.1",
	"gd": {
		"win": "2.2081",
		"mac": "2.2081",
		"android": "2.2081",
		"ios": "2.2081"
	},
	"id": "square3ang.cbfextrapolate",
	"name": "CBF Extrapolate",
	"version": "v2.4.0",
	"developer": "square3ang",
	"description": "Frame extrapolation for smoother rendering.",
	"dependencies": {
		"syzzi.click_between_frames": {
			"version": ">=v1.0.5",
			"required": false
		},
		"geode.custom-keybinds": {
			"version": ">=v2.0.0",
			"required": false
		}
	},
	"tags": [
		"gameplay",
		"enhancement",
		"cheat"
	],
	"links": {
		"source": "https://github.com/square3ang/CBFExtrapolate"
	},
	"settings": {
		"soft-toggle": {
			"name": "Soft Toggle",
			"description": "Disables CBF Extrapolate features.",
			"type": "bool",
			"default": false
		},
		"wine-cbf-workaround": {
			"name": "Wine CBF Workaround",
			"description": "Read the input CBF's Linux helper captures (its Wine workaround path) so early clicks show in the frame being drawn. Requires Click Between Frames v1.5.0.",
			"type": "bool",
			"default": true,
			"enable-if": "saved:cbf-1-5-0",
			"enable-if-description": "Requires Click Between Frames v1.5.0"
		}
	}
}
